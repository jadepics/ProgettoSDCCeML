# ============================================================
# Worker environment example for ProgettoSDCCeML
# ============================================================
# Copy this file to .env.worker before running scripts/worker.sh:
#   cp .env.worker.example .env.worker

WORKER_ID=worker1
WORKER_BIND_HOST=0.0.0.0
WORKER_PORT=50061
# WORKER_ADVERTISE_HOST=172.31.x.x

MASTER_DEPLOYMENT_MODE=multi-host
MASTER1_PRIVATE_IP=172.31.37.47
MASTER2_PRIVATE_IP=172.31.33.26
MASTER3_PRIVATE_IP=172.31.35.187
MASTER_SEEDS=172.31.37.47:50051,172.31.33.26:50051,172.31.35.187:50051

MASTER_HOST=127.0.0.1
MASTER_PORT=50051
MASTER_LEADER_HOST=127.0.0.1
MASTER_LEADER_PORT=50051

ARTIFACT_ROOT=/mnt/efs/gp_artifacts
SHARED_STORAGE_ROOT=/mnt/efs/gp_artifacts

MAX_CONCURRENT_TASKS=1
WORKER_MAX_WORKERS=16

GRPC_MAX_MESSAGE_LENGTH_MB=256

# Optional chaos/fault-tolerance testing.
# Leave empty during normal runs.
CHAOS_POINT=
CHAOS_ACTION=crash
CHAOS_DELAY_SECONDS=0
CHAOS_SLEEP_SECONDS=999999