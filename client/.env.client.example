# Comma-separated list of master gRPC endpoints.
# In multi-host mode each master runs on a different EC2 instance.
# The client tries each endpoint until it finds the leader.
MASTER_SEEDS=172.31.37.47:50051,172.31.33.26:50052,172.31.35.187:50053

# Maximum gRPC message size in MiB.
GRPC_MAX_MESSAGE_LENGTH_MB=256

# Timeout used by client calls to the master.
CLIENT_GRPC_TIMEOUT_SECONDS=120