+
+request = pb.SubmitTrainingRequest(
+    dataset_url=str(dataset_path),
+    target_column="hba1c",
+    task_type="regression",
+    n_estimators_total=4,
+    validation_ratio=0.2,
+    test_ratio=0.2,
+    bootstrap=True,
+    global_random_seed=42,
+    max_depth_candidates=[5],
